# Feature Flags for RTI-Ease Phase Rollout
# Set to 'true' to enable a feature, 'false' or omit to disable

# Phase 1: Quick Wins
NEXT_PUBLIC_ENABLE_PRINT_CSS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_SEARCH=true

# Phase 2: Medium Complexity
NEXT_PUBLIC_ENABLE_EMAIL=false
NEXT_PUBLIC_ENABLE_TEMPLATES=false

# Phase 3: Advanced
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_I18N=false
